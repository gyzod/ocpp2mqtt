MQTT_PORT=1883
MQTT_HOSTNAME=xxx.xxx.xxx.xxx
MQTT_BASEPATH='ocpp/charger1'
MQTT_USERNAME=johnny
MQTT_PASSWORD=mypassword
MQTT_TRANSPORT=tcp
MQTT_KEEPALIVE=60
MQTT_TIMEOUT=30
MQTT_RECONNECT_BASE_DELAY=5
MQTT_RECONNECT_MAX_DELAY=60

# OCPP command timeout (seconds)
OCPP_COMMAND_TIMEOUT=30
# Max concurrent OCPP commands per charge point. Keep at 1 for charge points
# that process commands sequentially.
OCPP_MAX_CONCURRENT_COMMANDS=1
# Ignore identical ChangeConfiguration commands received within this window.
# Other command types are never deduplicated. Set to 0 to disable.
OCPP_DEDUP_WINDOW=300
# Grace period (seconds) after MQTT (re)connection during which retained
# command messages are ignored. Prevents replaying stale commands on reconnect.
MQTT_RETAINED_CMD_GRACE=5
#MQTT_CLIENT_ID=ocpp2mqtt-charger1
#MQTT_WEBSOCKET_PATH=/mqtt
#MQTT_WEBSOCKET_HEADERS='{"Sec-WebSocket-Protocol": "mqtt"}'

LISTEN_PORT=3000
LISTEN_ADDR=0.0.0.0
# Optional WebSocket Basic Authentication
# WEBSOCKET_AUTH_USERNAME=ocpp-client
# WEBSOCKET_AUTH_PASSWORD=change-me

AUTHORIZED_TAG_ID_LIST='["johnny-car","uc_default_auth"]'
